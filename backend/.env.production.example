# ── Gerado automaticamente pelo Railway ──────────────────────────────────────
ENVIRONMENT=production

# URLs — preencher após criar os serviços
FRONTEND_URL=https://SEU-PROJETO.vercel.app
BACKEND_URL=https://SEU-BACKEND.railway.app

# Segurança — gerar chaves aleatórias longas
SECRET_KEY=GERE-UMA-CHAVE-ALEATORIA-LONGA-32-CHARS
ADMIN_SECRET_KEY=GERE-OUTRA-CHAVE-ALEATORIA

# Banco — Railway PostgreSQL (colado automático pelo Railway)
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME

# Redis — Upstash (formato: rediss://...)
REDIS_URL=rediss://default:TOKEN@HOST:PORT

# IA — Groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Email — Resend
RESEND_API_KEY=re_...
EMAIL_FROM=Orbita <noreply@seudominio.com>

# Pagamentos — Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# WhatsApp — URL do serviço Railway
EVOLUTION_API_URL=https://SEU-WHATSAPP.railway.app
EVOLUTION_API_KEY=orbita-evolution-key-dev

# Trial
TRIAL_DIAS=30
